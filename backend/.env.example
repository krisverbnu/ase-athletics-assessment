# Neon PostgreSQL (pooled: used by the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon PostgreSQL (direct: used by Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens (JWTs): any long random string
JWT_SECRET=change-me

# The frontend allowed to call this API
CLIENT_URL=http://localhost:5173
